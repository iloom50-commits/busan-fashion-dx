rules_version = '2';

// ============================================================================
// 2026 부산 패션(봉제) 소공인 DX 역량진단 · Firestore 보안규칙
//
// [적용 방법]
//   Firebase 콘솔 > Firestore Database > 규칙 탭에 아래 내용을 붙여넣고 게시
//   프로젝트: dx-tool-d262e
//
// [채택한 방식] 개인정보 최소화 (백엔드 미도입)
//   대표자명·연락처·이메일을 Firestore에 저장하지 않는다.
//   저장하지 않은 정보는 유출되지 않으므로, 읽기를 열어 두어도 개인정보가 노출되지 않는다.
//   대표자·연락처 명부는 부산테크노파크가 별도로 보유한다 (과업지시서 66행).
//   근거: docs/superpowers/specs/2026-08-13-privacy-minimization-design.md
//
// [이 규칙이 막는 것]
//   · 저장된 진단 기록의 수정·삭제
//   · 형식이 맞지 않는 문서 생성
//   · 클라이언트가 임의 시각을 timestamp로 넣는 것
//   · diagnoses 이외 경로에 대한 모든 접근
//
// [이 규칙이 막지 않는 것]
//   · 기업명·사업자번호·진단점수 조회. 위 설계에 따른 의도된 결과다.
//     이를 막으려면 백엔드가 필요하며, 10개사·단기 운용 조건에서 과하다고 판단했다.
//
// [주의] 게시 후 반드시 자가진단 제출을 1회 테스트할 것.
//        검증 조건이 실제 저장 필드와 어긋나면 제출이 실패한다.
//
// [주의] 게시 후에는 클라이언트에서 문서를 지울 수 없다.
//        데이터 정리가 필요하면 Firebase 콘솔에서 직접 수행한다.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /diagnoses/{docId} {

      allow read: if true;

      allow create: if isValidDiagnosis();

      allow update, delete: if false;
    }

    // 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidDiagnosis() {
      let d = request.resource.data;
      return d.keys().hasAll(['type', 'timestamp', 'company', 'track', 'scores'])
          && d.keys().size() <= 25
          && d.type in ['self', 'expert']
          && d.company is string && d.company.size() > 0 && d.company.size() <= 100
          && d.track in ['A', 'B', 'C']
          && d.scores is map
          && d.scores.keys().hasAll(['work', 'process', 'quality', 'material', 'basic', 'leader'])
          // serverTimestamp 강제 — 클라이언트가 임의 시각을 넣지 못하게 한다
          && request.time == d.timestamp;
    }
  }
}
